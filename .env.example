# Copie para .env e preencha. O .env NUNCA vai para o repositório.

# Conexão direta ao Postgres (Supabase → Database → Connection string → Transaction pooler)
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

# Token de administração do Supabase. Só é usado como fallback quando não há
# DATABASE_URL. Prefira não defini-lo: ele dá acesso a TODA a conta.
# SBT=

# Referência do projeto Supabase
SUPABASE_PROJECT_REF=ccquyncwgtszhicicvye

# Onde ficam os arquivos EFD para importação por linha de comando
DIR_EFD=C:\Users\SEU_USUARIO\Downloads

# Nome que fica registrado como responsável pelas importações
AUDITOR=
